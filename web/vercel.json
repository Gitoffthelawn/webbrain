{
  "redirects": [
    { "source": "/companion", "destination": "/companion/", "permanent": true },
    { "source": "/companion/tr", "destination": "/companion/tr/", "permanent": true },
    { "source": "/browser", "destination": "/", "permanent": true },
    { "source": "/browser/", "destination": "/", "permanent": true },
    { "source": "/:locale(es|fr|tr|zh|ru|uk|ar|ja|ko|id|th|ms|tl|he|hi|pt|vi|bn|fa|nl|de)/browser", "destination": "/:locale/", "permanent": true },
    { "source": "/:locale(es|fr|tr|zh|ru|uk|ar|ja|ko|id|th|ms|tl|he|hi|pt|vi|bn|fa|nl|de)/browser/", "destination": "/:locale/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/workflow-editor", "destination": "/workflow-editor/index.html" },
    { "source": "/workflow-editor/", "destination": "/workflow-editor/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/subscribe", "destination": "/subscribe/index.html" },
    { "source": "/subscribe/", "destination": "/subscribe/index.html" },
    { "source": "/companion/", "destination": "/companion/index.html" },
    { "source": "/companion/tr/", "destination": "/companion/tr/index.html" },
    { "source": "/websites", "destination": "/websites/index.html" },
    { "source": "/websites/", "destination": "/websites/index.html" },
    { "source": "/research", "destination": "/research/index.html" },
    { "source": "/research/", "destination": "/research/index.html" },
    { "source": "/research/:slug", "destination": "/research/:slug/index.html" },
    { "source": "/research/:slug/", "destination": "/research/:slug/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/blog/:slug/", "destination": "/blog/:slug/index.html" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/", "destination": "/docs/index.html" },
    { "source": "/docs/zh/:page", "destination": "/docs/zh/:page/index.html" },
    { "source": "/docs/zh/:page/", "destination": "/docs/zh/:page/index.html" },
    { "source": "/docs/:page", "destination": "/docs/:page/index.html" },
    { "source": "/docs/:page/", "destination": "/docs/:page/index.html" },
    { "source": "/:path*\\.(png|jpg|jpeg|gif|webp|svg|ico|css|js|map|txt|xml|json|woff|woff2|ttf|otf|mp4|webm|vtt)", "destination": "/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
